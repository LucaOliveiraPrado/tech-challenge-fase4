# Copie para .env e preencha. O .env nunca é versionado.

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de geração e modelo juiz da avaliação
VOC_LLM_MODEL=gemini-2.5-flash
VOC_JUDGE_MODEL=gemini-2.5-flash

# Modelos locais (Hugging Face)
VOC_EMBEDDING_MODEL=BAAI/bge-m3
VOC_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# cuda | cpu | auto
VOC_DEVICE=auto
