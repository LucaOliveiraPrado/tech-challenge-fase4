# Copie para .env e preencha. O .env nunca é versionado.

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelos Gemini (plano gratuito: cota diária POR modelo, por isso os fallbacks)
VOC_LLM_MODEL=gemini-3.5-flash-lite
VOC_LLM_FALLBACK=gemini-3.1-flash-lite
VOC_JUDGE_MODEL=gemini-3.6-flash
VOC_JUDGE_FALLBACK=gemini-3.7-flash,gemini-3.8-flash

# Modelos locais (Hugging Face)
VOC_EMBEDDING_MODEL=BAAI/bge-m3
VOC_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# cuda | cpu | auto
VOC_DEVICE=auto
